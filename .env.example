# Submission backend for quote requests.
#   mock      — simulated send, nothing leaves the device (default in development)
#   web3forms — real send through Web3Forms (the same service the current website uses)
VITE_SUBMIT_MODE=mock

# Web3Forms access key. The live website embeds this public key in its bundle:
# bebd4b04-e553-485e-8594-97fd812b13d4 — reuse it, or create a dedicated key for the app
# at https://web3forms.com so app requests can be filtered separately.
VITE_WEB3FORMS_KEY=
